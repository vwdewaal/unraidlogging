# Copy to /boot/config/system-logging/snmp-trap.conf, fill the values, then run:
# chmod 600 /boot/config/system-logging/snmp-trap.conf
#
# This file is intentionally excluded from Git. Use unique long passphrases.

SNMP_TRAP_HOST="192.168.68.250"
SNMP_TRAP_PORT="162"
SNMP_TRAP_USER="unraid-health"
SNMP_TRAP_AUTH_PROTOCOL="SHA"
SNMP_TRAP_AUTH_PASSWORD="replace-with-a-long-unique-passphrase"
SNMP_TRAP_PRIV_PROTOCOL="AES"
SNMP_TRAP_PRIV_PASSWORD="replace-with-a-different-long-unique-passphrase"
